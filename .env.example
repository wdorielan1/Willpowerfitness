# Optional: enables real Google Sign-In (Google Identity Services). Without it, a demo Google flow is used.
VITE_GOOGLE_CLIENT_ID=

# Backend (Supabase). Leave blank to run local-only. Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: free key from https://fdc.nal.usda.gov/api-key-signup for whole-food search (Open Food Facts needs no key)
VITE_USDA_API_KEY=
