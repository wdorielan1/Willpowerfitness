# Optional: enables real Google Sign-In (Google Identity Services). Without it, a demo Google flow is used.
VITE_GOOGLE_CLIENT_ID=

# Optional: enables real Sign in with Apple (Services ID from developer.apple.com).
# The redirect URI must be an HTTPS domain registered on that Services ID.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
