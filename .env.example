# Optional: enables real Google Sign-In (Google Identity Services). Without it, a demo Google flow is used.
VITE_GOOGLE_CLIENT_ID=

# Backend (Supabase). Leave blank to run local-only. Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: free key from https://fdc.nal.usda.gov/api-key-signup for whole-food search (Open Food Facts needs no key)
VITE_USDA_API_KEY=
# Optional: set to 1 only AFTER the People API is enabled and the birthday permission (user.birthday.read) is added on the Google Cloud consent screen.
# Then people who sign in with Google skip the age page. Asking for a permission that isn't set up there makes Google refuse the sign in.
VITE_GOOGLE_BIRTHDAY=
